# Environment Variables for AxivoraX Backend

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://pnknjoeaacyttttgpabv.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# FYERS Configuration
FYERS_CLIENT_ID=your_fyers_client_id_here
FYERS_SECRET=your_fyers_secret_here
FYERS_REDIRECT_URI=http://localhost:5000/api/auth/fyers/callback

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=axivorax_db
DB_USER=postgres
DB_PASSWORD=password

# API Keys
OPENAI_API_KEY=your_openai_api_key_for_ai_insights
REDIS_URL=redis://localhost:6379